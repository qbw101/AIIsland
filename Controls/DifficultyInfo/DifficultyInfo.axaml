<ci:ComponentBase
    x:Class="ClassIsland.AISmartClass.Controls.DifficultyInfo.DifficultyInfo"
    x:TypeArguments="models:DifficultyInfoSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:models="clr-namespace:ClassIsland.AISmartClass.Models"
    FontSize="{Binding Settings.FontSize, FallbackValue=14}">

    <ci:ComponentBase.Styles>
        <StyleInclude Source="avares://ClassIsland.AISmartClass/Styles/ComponentStyles.axaml"/>
    </ci:ComponentBase.Styles>

    <Border Classes="aiIslandRoot">
        <!-- 两项自动折行：任一开关关闭后不留空白列 -->
        <WrapPanel Orientation="Horizontal">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                  Margin="0,0,20,4"
                  IsVisible="{Binding Settings.ShowDifficulty}">
                <TextBlock Grid.Column="0" Classes="aiIslandIcon" Text="&#xE002;"/>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="aiIslandLabel" Text="课程难度"/>
                    <TextBlock Classes="aiIslandBody" Text="{Binding DifficultyLabel}"/>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                  Margin="0,0,20,4"
                  IsVisible="{Binding Settings.ShowPomodoro}">
                <TextBlock Grid.Column="0" Classes="aiIslandIcon" Text="&#xF0184;"/>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="aiIslandLabel" Text="建议专注"/>
                    <TextBlock Classes="aiIslandBody" Text="{Binding PomodoroSuggestion}"/>
                </StackPanel>
            </Grid>
        </WrapPanel>
    </Border>
</ci:ComponentBase>

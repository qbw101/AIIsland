<ci:ComponentBase
    x:Class="ClassIsland.AISmartClass.Controls.ScheduleInsight.ScheduleInsight"
    x:TypeArguments="models:ScheduleInsightSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:models="clr-namespace:ClassIsland.AISmartClass.Models"
    FontSize="{Binding Settings.FontSize, FallbackValue=14}">

    <ci:ComponentBase.Styles>
        <StyleInclude Source="avares://ClassIsland.AISmartClass/Styles/ComponentStyles.axaml"/>
    </ci:ComponentBase.Styles>

    <Border Classes="aiIslandRoot">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="aiIslandIcon" Text="&#xE005;"/>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Classes="aiIslandLabel" Text="今日课表"/>
                <TextBlock Classes="aiIslandBody"
                           Text="{Binding Summary}"
                           ToolTip.Tip="{Binding Summary}"/>
            </StackPanel>
        </Grid>
    </Border>
</ci:ComponentBase>

<ci:ComponentBase
    x:Class="ClassIsland.AISmartClass.Controls.SmartClassPanel.SmartClassPanel"
    x:TypeArguments="models:SmartClassPanelSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:models="clr-namespace:ClassIsland.AISmartClass.Models"
    xmlns:local="clr-namespace:ClassIsland.AISmartClass.Controls.SmartClassPanel"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:SmartClassPanel}"
    FontSize="12"
    MaxHeight="{Binding Settings.PanelMaxHeight}">

    <ci:ComponentBase.Styles>
        <StyleInclude Source="avares://ClassIsland.AISmartClass/Styles/ComponentStyles.axaml"/>
    </ci:ComponentBase.Styles>

    <Border Classes="aiIslandRoot" Padding="8,4">
        <StackPanel Spacing="4">

            <!-- AI 状态：单色图标 + 文字，无背景条 -->
            <Grid IsVisible="{Binding IsAIThinking}"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="6">
                <TextBlock Grid.Column="0"
                           Classes="aiIslandIcon aiIslandIconInline"
                           Text="&#xE002;"/>
                <TextBlock Grid.Column="1"
                           Classes="aiIslandLabel"
                           Text="{Binding AIStatusText}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- 课表总结 -->
            <Grid IsVisible="{Binding Settings.ShowTodayOverview}"
                  ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="6">
                <TextBlock Grid.Column="0"
                           Classes="aiIslandIcon aiIslandIconInline"
                           Text="&#xE005;"/>
                <TextBlock Grid.Column="1"
                           Classes="aiIslandLabel aiIslandLabelInline"
                           Text="今日课表"/>
                <TextBlock Grid.Column="2"
                           Classes="aiIslandBody aiIslandBodyCompact"
                           Text="{Binding TodaySummary}"
                           ToolTip.Tip="{Binding TodaySummary}"/>
            </Grid>

            <!-- 作业量预估 -->
            <Grid IsVisible="{Binding Settings.ShowHomeworkEstimate}"
                  ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="6">
                <TextBlock Grid.Column="0"
                           Classes="aiIslandIcon aiIslandIconInline"
                           Text="&#xE004;"/>
                <TextBlock Grid.Column="1"
                           Classes="aiIslandLabel aiIslandLabelInline"
                           Text="作业量预估"/>
                <TextBlock Grid.Column="2"
                           Classes="aiIslandBody aiIslandBodyCompact"
                           Text="{Binding HomeworkEstimate}"
                           ToolTip.Tip="{Binding HomeworkEstimate}"/>
            </Grid>

            <!-- 课时倒计时：纯数字，不占额外高度 -->
            <Grid IsVisible="{Binding Settings.ShowCountdown}"
                  ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="6"
                  Margin="0,1,0,0">
                <TextBlock Grid.Column="0"
                           Classes="aiIslandIcon aiIslandIconInline"
                           Text="&#xE001;"/>
                <TextBlock Grid.Column="1"
                           Classes="aiIslandLabel aiIslandLabelInline"
                           Text="课时倒计时"/>
                <TextBlock Grid.Column="2"
                           Classes="aiIslandBody aiIslandBodyCompact"
                           Text="{Binding CountdownText}"
                           ToolTip.Tip="{Binding CountdownText}"/>
            </Grid>

            <!-- 贴心提示 -->
            <Grid IsVisible="{Binding Settings.ShowCurrentHint}"
                  ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="6"
                  Margin="0,1,0,0">
                <TextBlock Grid.Column="0"
                           Classes="aiIslandIcon aiIslandIconInline"
                           Text="&#xE003;"/>
                <TextBlock Grid.Column="1"
                           Classes="aiIslandLabel aiIslandLabelInline"
                           Text="贴心提示"/>
                <TextBlock Grid.Column="2"
                           Classes="aiIslandBody aiIslandBodyCompact"
                           Text="{Binding CurrentHint}"
                           ToolTip.Tip="{Binding CurrentHint}"/>
            </Grid>

            <!-- 难度与专注建议 -->
            <WrapPanel IsVisible="{Binding ShowExtras}"
                       Orientation="Horizontal"
                       Margin="0,1,0,0">
                <Grid ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="4"
                      Margin="0,0,14,2"
                      IsVisible="{Binding Settings.ShowDifficulty}">
                    <TextBlock Grid.Column="0"
                               Classes="aiIslandIcon aiIslandIconInline"
                               Text="&#xE002;"/>
                    <TextBlock Grid.Column="1"
                               Classes="aiIslandLabel aiIslandLabelInline"
                               Text="难度"/>
                    <TextBlock Grid.Column="2"
                               Classes="aiIslandBody aiIslandBodyCompact"
                               Text="{Binding DifficultyLabel}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="4"
                      Margin="0,0,14,2"
                      IsVisible="{Binding Settings.ShowPomodoro}">
                    <TextBlock Grid.Column="0"
                               Classes="aiIslandIcon aiIslandIconInline"
                               Text="&#xF0184;"/>
                    <TextBlock Grid.Column="1"
                               Classes="aiIslandLabel aiIslandLabelInline"
                               Text="专注"/>
                    <TextBlock Grid.Column="2"
                               Classes="aiIslandBody aiIslandBodyCompact"
                               Text="{Binding PomodoroSuggestion}"/>
                </Grid>
            </WrapPanel>

        </StackPanel>
    </Border>
</ci:ComponentBase>

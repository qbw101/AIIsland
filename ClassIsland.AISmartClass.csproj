<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>ClassIsland.AISmartClass</AssemblyName>
        <RootNamespace>ClassIsland.AISmartClass</RootNamespace>
        <!-- 关键：启用动态加载（官方模板要求） -->
        <EnableDynamicLoading>True</EnableDynamicLoading>
    </PropertyGroup>

    <ItemGroup>
        <!-- ClassIsland 插件 SDK -->
        <PackageReference Include="ClassIsland.PluginSdk" Version="2.0.0.2">
            <!-- 排除运行时资产，避免与 ClassIsland 主程序 DLL 冲突 -->
            <ExcludeAssets>runtime;native</ExcludeAssets>
        </PackageReference>
        <!-- MVVM 工具包（主程序已有，排除运行时避免冲突） -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2">
            <ExcludeAssets>runtime;native</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- 独立作业清单插件位于仓库子目录，不参与 AIIsland 程序集编译。 -->
    <ItemGroup>
        <Compile Remove="ClassIsland.HomeworkList\**\*.cs" />
        <AvaloniaXaml Remove="ClassIsland.HomeworkList\**\*.axaml" />
        <AvaloniaResource Remove="ClassIsland.HomeworkList\**\*.axaml" />
        <EmbeddedResource Remove="ClassIsland.HomeworkList\**\*" />
        <None Remove="ClassIsland.HomeworkList\**\*" />
    </ItemGroup>

    <!-- Data 目录作为独立文件复制到输出目录 -->
    <ItemGroup>
        <Content Include="Data\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Content>
    </ItemGroup>

    <!-- manifest.yml / README.md 作为独立文件复制到输出目录 -->
    <ItemGroup>
        <Content Include="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="PLUGIN-API.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- 插件图标 -->
    <ItemGroup>
        <Content Include="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <AvaloniaResource Include="icon.png" />
        <AvaloniaResource Include="icon\icon.png" />
        <AvaloniaResource Include="icon\ok.png" />
        <AvaloniaResource Include="icon\ok-wizard.png" />
        <AvaloniaResource Include="icon\welcome.png" />
        <AvaloniaResource Include="icon\AIIslandIcons.ttf" />
    </ItemGroup>

</Project>

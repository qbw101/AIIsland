<ci:SettingsPageBase
    x:Class="ClassIsland.AISmartClass.Views.SettingsPages.AISettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:publicApi="clr-namespace:ClassIsland.AISmartClass.PublicApi"
    xmlns:controls="clr-namespace:ClassIsland.AISmartClass.Controls"
    xmlns:converters="clr-namespace:ClassIsland.AISmartClass.Converters">

    <ci:SettingsPageBase.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
    </ci:SettingsPageBase.Resources>

    <ci:SettingsPageBase.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>
        <Style Selector="Expander.settings-section">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- 二级菜单标题：无图标、无额外缩进，文字在 66px 高度内垂直居中，与 setting-row 的行标题左对齐 -->
        <Style Selector="Grid.subsection-header">
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 二级菜单内容不做淡入，避免被一级分组的展开动画规则重复作用 -->
        <Style Selector="StackPanel.subsection-content">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style Selector="Grid.section-header">
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style Selector="TextBlock.expander-icon">
            <Setter Property="FontFamily" Value="avares://ClassIsland.AISmartClass/icon/#AIIsland Icons"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.expander-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.expander-description">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="StackPanel.section-content">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translate(0px, -6px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Expander.settings-section:expanded StackPanel.section-content">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
        </Style>
        <Style Selector="Border.setting-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.setting-row">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.setting-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.row-icon">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Expander.settings-section TextBlock.row-icon">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Width" Value="0"/>
        </Style>
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.row-description">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <StyleInclude Source="avares://ClassIsland.AISmartClass/Styles/StableButtonStyles.axaml"/>
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="NumericUpDown:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
        </Style>
        <Style Selector="NumericUpDown:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="OffContent" Value="关"/>
            <Setter Property="OnContent" Value="开"/>
        </Style>
    </ci:SettingsPageBase.Styles>

    <!-- 根 Grid 只为了托住右下角的 toast 浮层；页面主体仍是原来的 ScrollViewer -->
    <Grid>
    <ScrollViewer>
        <StackPanel Spacing="6" Margin="20,10,20,20" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="插件信息" Classes="section-title"/>

            <Border Classes="setting-card" Padding="18,14">
                <Grid ColumnDefinitions="58,*" ColumnSpacing="16">
                    <Image Source="avares://ClassIsland.AISmartClass/icon.png"
                           Width="44" Height="44" Stretch="Uniform"
                           VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="AIIsland"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="VersionLabel"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock Text="AI 驱动的智能课表助手"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="用于 ClassIsland 的智能提醒、总结与考试倒计时辅助插件。"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF05AF;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="考试模式" Classes="expander-title"/>
                            <TextBlock Text="启动考试倒计时仪表盘并管理考试期间的辅助功能。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">
            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE121;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="考试模式" Classes="row-title"/>
                        <TextBlock Text="打开浏览器显示考试倒计时仪表盘，适合考试期间投屏。" Classes="row-description"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ExamModeButton" Content="启动考试模式" VerticalAlignment="Center"/>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="True">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF0274;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="API 连接" Classes="expander-title"/>
                            <TextBlock Text="配置模型接口、密钥和语气，并测试 AI 生成功能。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,2*" ColumnSpacing="14">
                    <TextBlock Text="&#xE71B;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="API 地址" Classes="row-title"/>
                        <TextBlock Text="兼容 OpenAI Chat Completions 的接口地址。" Classes="row-description"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" x:Name="EndpointBox"
                             Watermark="https://api.deepseek.com/chat/completions"
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,2*" ColumnSpacing="14">
                    <TextBlock Text="&#xE192;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="API Key" Classes="row-title"/>
                        <TextBlock Text="用于调用模型接口的访问密钥。" Classes="row-description"/>
                    </StackPanel>
                    <TextBox Grid.Column="2" x:Name="ApiKeyBox"
                             PasswordChar="•" Watermark="sk-..."
                             VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,320" ColumnSpacing="14">
                    <TextBlock Text="&#xE950;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="模型名称" Classes="row-title"/>
                        <TextBlock Text="用于生成提醒和总结的模型，可从接口读取可用列表。" Classes="row-description"/>
                    </StackPanel>
                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBox x:Name="ModelBox"
                                 Watermark="deepseek-chat"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="FetchModelsButton"
                                Content="获取模型"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE8B9;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="图片识别能力" Classes="row-title"/>
                        <TextBlock x:Name="VisionSupportHint"
                                   Text="点「检测」向接口发送一张测试图片，确认该模型是否支持图片识别。"
                                   Classes="row-description"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border x:Name="VisionSupportBadge" Width="84" Height="24"
                                CornerRadius="12" Padding="0" BorderThickness="0"
                                Background="#5D5D5D" VerticalAlignment="Center">
                            <TextBlock x:Name="VisionSupportText" Text="未检测" FontSize="12"
                                       FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center"/>
                        </Border>
                        <Button x:Name="DetectVisionButton" Content="检测"
                                VerticalAlignment="Center"
                                ToolTip.Tip="发送一张写着随机数字的测试图片，确认模型能否读取图片"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,320" ColumnSpacing="14">
                    <TextBlock Text="&#xE8BD;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="语气风格" Classes="row-title"/>
                        <TextBlock Text="控制 AI 回复的整体表达风格。" Classes="row-description"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="ToneStyleComboBox" SelectedIndex="1" VerticalAlignment="Center">
                        <ComboBoxItem Tag="0">活泼 — 轻二次元风格</ComboBoxItem>
                        <ComboBoxItem Tag="1">标准 — 自然随和（推荐）</ComboBoxItem>
                        <ComboBoxItem Tag="2">严肃 — 正式专业</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE716;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="角色语气" Classes="row-title"/>
                        <TextBlock Text="让 AI 用某个角色（如甘雨、胡桃）的口吻表达，独立叠加在语气风格之上。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="PersonaEnabledSwitch" IsChecked="False"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,320" ColumnSpacing="14">
                    <TextBlock Text="&#xE77B;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="角色预设" Classes="row-title"/>
                        <TextBlock Text="选择一个内置角色，或选择「自定义角色」自己填写设定。" Classes="row-description"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="PersonaComboBox" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,360" ColumnSpacing="14">
                    <TextBlock Text="&#xE70F;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="自定义角色设定" Classes="row-title"/>
                        <TextBlock Text="第一行写「角色名称：XX」，下面是语气与用词习惯；选中「自定义角色」时生效，也可用右侧按钮让 AI 生成。" Classes="row-description"/>
                    </StackPanel>
                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                        <TextBox x:Name="CustomPersonaBox"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="64" MaxHeight="120"
                                 Watermark="例如：温柔耐心，说话轻声细语，喜欢鼓励别人"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="GeneratePersonaButton" Content="AI 生成"
                                MinWidth="88" VerticalAlignment="Center"
                                ToolTip.Tip="用 AI 生成一段角色语气设定，生成后可预览并编辑"
                                Click="OnGeneratePersonaClicked"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE777;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="自定义温度" Classes="row-title"/>
                        <TextBlock Text="0.0-2.0，留空使用语气风格默认值。某些AI大模型可能需要特定温度。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="CustomTemperatureBox"
                                   Minimum="0" Maximum="2" Increment="0.1"
                                   FormatString="F1"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE9D9;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="连接与生成测试" Classes="row-title"/>
                        <TextBlock Text="保存配置前可先验证接口连接、课间贴心提醒和放学贴心总结。" Classes="row-description"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TestButton" Content="测试 API" Margin="0,0,8,0"/>
                        <Button x:Name="TestBeforeSchoolButton" Content="测试智能每日简报" Margin="0,0,8,0"/>
                        <Button x:Name="TestReminderButton" Content="测试课间提醒" Margin="0,0,8,0"/>
                        <Button x:Name="TestSummaryButton" Content="测试放学总结" Margin="0,0,8,0"/>
                        <Button x:Name="SaveButton" Content="保存" Classes="primary"/>
                    </WrapPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF0168;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="生成参数" Classes="expander-title"/>
                            <TextBlock Text="调整思考方式、回复长度、请求超时、缓存时长、重试和日志保留策略。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE82F;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="深度思考" Classes="row-title"/>
                        <TextBlock Text="让模型先推理再回答，复杂问题更准；更慢，也更耗 token。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="DeepThinkingSwitch" IsChecked="False"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE9D9;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="思考强度" Classes="row-title"/>
                        <TextBlock Text="越高越深入也越慢，仅在开启深度思考时生效；部分模型不支持调节，会按默认强度思考。" Classes="row-description"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="ThinkingEffortComboBox" VerticalAlignment="Center">
                        <ComboBoxItem Tag="0">自动（跟随模型）</ComboBoxItem>
                        <ComboBoxItem Tag="1">低 — 更快</ComboBoxItem>
                        <ComboBoxItem Tag="2">中 — 平衡</ComboBoxItem>
                        <ComboBoxItem Tag="3">高 — 更深入</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE8A5;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="最大回复长度" Classes="row-title"/>
                        <TextBlock Text="限制单次 AI 回复可生成的最大 token 数；开启深度思考时会自动为思考过程额外预留；填 0 表示不限制。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="MaxTokensBox"
                                   Minimum="0" Maximum="500" Increment="50" Value="200"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE916;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="超时时间（秒）" Classes="row-title"/>
                        <TextBlock Text="接口请求超过该时间后视为失败；填 0 表示不限制，会一直等到模型返回或手动取消。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="TimeoutBox"
                                   Minimum="0" Maximum="30" Value="10"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE8FD;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="缓存时长（分钟）" Classes="row-title"/>
                        <TextBlock Text="相同课程上下文可复用 AI 回复的时间范围。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="CacheBox"
                                   Minimum="1" Maximum="60" Value="5"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE72C;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="失败重试次数" Classes="row-title"/>
                        <TextBlock Text="接口调用失败后自动重试的次数。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="MaxRetriesBox"
                                   Minimum="0" Maximum="5" Value="1"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE74D;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="AI 日志保留天数" Classes="row-title"/>
                        <TextBlock Text="自动清理超过保留期的 AI 调用日志，默认保留 30 天。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="AiLogRetentionDaysBox"
                                   Minimum="1" Maximum="365" Value="30"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xE721;" Classes="expander-icon" FontFamily="Segoe MDL2 Assets"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="联网搜索" Classes="expander-title"/>
                            <TextBlock Text="让模型在需要实时信息时自主联网检索，回答里会标注引用来源。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE774;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="允许模型联网搜索" Classes="row-title"/>
                        <TextBlock Text="关闭时不影响任何请求；开启后模型会在需要时调用搜索工具。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="WebSearchSwitch" IsChecked="False"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE8A7;" Classes="row-icon" FontFamily="Segoe MDL2 Assets"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="允许模型打开网页" Classes="row-title"/>
                        <TextBlock Text="搜索摘要不够时，模型可打开网页读取正文。" Classes="row-description"/>
                        <TextBlock Text="抓不到的页面会退回摘要，不会编造内容。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="WebFetchSwitch" IsChecked="True"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE8D7;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="DeepSeek 官方联网兜底" Classes="row-title"/>
                        <TextBlock Text="搜索没有有效结果、或网页抓不开时，改用 DeepSeek 官方接口再试一次。" Classes="row-description"/>
                        <TextBlock Text="使用你自己的 API Key 与余额，按次计费。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="DeepSeekFallbackSwitch" IsChecked="False"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE8FD;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="单次检索条数" Classes="row-title"/>
                        <TextBlock Text="回传给模型的资料条数。条数越多信息越全，上下文占用和延迟也越高。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="WebSearchMaxResultsBox"
                                   Minimum="1" Maximum="10" Value="5"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,160" ColumnSpacing="14">
                    <TextBlock Text="&#xE916;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="检索超时（秒）" Classes="row-title"/>
                        <TextBlock Text="单次检索的独立超时，与 AI 请求超时互不影响。超时后自动降级为不联网回答。" Classes="row-description"/>
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" x:Name="WebSearchTimeoutBox"
                                   Minimum="3" Maximum="30" Value="8"
                                   VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE9D9;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="测试搜索" Classes="row-title"/>
                        <TextBlock Text="测试搜索服务连通性" Classes="row-description"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="TestWebSearchButton"
                            Content="测试" VerticalAlignment="Center" MinWidth="104"/>
                </Grid>
            </Border>

                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF0036;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="功能开关" Classes="expander-title"/>
                            <TextBlock Text="控制缓存、离线降级和考试模式语气等 AI 行为。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE945;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="启用 AI 缓存" Classes="row-title"/>
                        <TextBlock Text="减少重复请求，降低接口延迟和调用次数。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="EnableCacheCb" IsChecked="True"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE7BE;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="考试模式严肃语气" Classes="row-title"/>
                        <TextBlock Text="考试模式启动时自动使用正式专业语气。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="ExamSeriousToneCb" IsChecked="True"/>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF0504;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="时间来源" Classes="expander-title"/>
                            <TextBlock Text="统一决定课表、倒计时、提醒和考试模式使用哪一种时间。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE916;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="业务时间来源" Classes="row-title"/>
                        <TextBlock Text="所有组件统一使用此设置。选 ClassIsland 时间可跟随主程序的时间偏移与校时；旧版课时倒计时组件中的独立选项已移除。"
                                   Classes="row-description"/>
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="TimeSourceComboBox" MinWidth="220"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBoxItem Content="ClassIsland 时间（含偏移）" Tag="ClassIslandTime"/>
                        <ComboBoxItem Content="系统时间" Tag="SystemTime"/>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE946;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="始终使用真实时间的场景" Classes="row-title"/>
                        <TextBlock Text="AI 提示词中的日期时间、日志与授权记录、网络校时、通信过期校验、缓存有效期、超时与防抖不受上方设置影响，避免把真实发生的记录改成课表时间。"
                                   Classes="row-description"/>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF0142;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="托盘菜单快捷操作" Classes="expander-title"/>
                            <TextBlock Text="选择显示在 ClassIsland 托盘菜单中的 AIIsland 快捷入口。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*" ColumnSpacing="14">
                    <TextBlock Text="&#xE7F4;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="显示的快捷操作" Classes="row-title"/>
                            <TextBlock Text="选择右键 ClassIsland 托盘图标时显示在 AIIsland 菜单中的操作，修改后立即生效。" Classes="row-description" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="TrayExamModeCb" Content="启动考试模式" Margin="0,0,24,8"/>
                            <CheckBox x:Name="TrayRegenerateSummaryCb" Content="重新生成课表总结" Margin="0,0,24,8"/>
                            <CheckBox x:Name="TrayRegenerateHintCb" Content="重新生成学习提示" Margin="0,0,24,8"/>
                            <CheckBox x:Name="TrayRegenerateHomeworkCb" Content="重新生成作业量估算" Margin="0,0,24,8"/>
                            <CheckBox x:Name="TrayBeforeSchoolReminderCb" Content="生成智能每日简报" Margin="0,0,24,8"/>
                            <CheckBox x:Name="TrayBeforeClassReminderCb" Content="生成课间贴心提醒" Margin="0,0,24,8"/>
                            <CheckBox x:Name="TrayAfterSchoolSummaryCb" Content="生成放学贴心总结" Margin="0,0,24,8"/>
                            <CheckBox x:Name="TrayCustomRemindersCb" Content="管理自定义提醒" Margin="0,0,24,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF045E;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="外部插件授权" Classes="expander-title"/>
                            <TextBlock Text="管理其他插件调用 AIIsland API 时的授权策略和记录。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE8E8;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="默认授权策略" Classes="row-title"/>
                        <TextBlock Text="新插件首次调用 AI 时的处理方式。可逐个插件调整。" Classes="row-description"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" x:Name="DefaultAuthTrustedSwitch"
                                  IsChecked="False"
                                  OffContent="每次确认"
                                  OnContent="直接授权"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*" ColumnSpacing="14">
                    <TextBlock Text="&#xE730;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Spacing="2">
                            <TextBlock Text="已授权插件列表" Classes="row-title"/>
                            <TextBlock Text="管理已调用过 AIIsland API 的外部插件。可切换为「直接授权」或「每次确认」，也可撤销授权。" Classes="row-description" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ItemsControl x:Name="PluginAuthList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="publicApi:AIIslandPluginAuthEntry">
                                    <Border Classes="setting-card" Margin="0,2" Padding="12,10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding PluginName}" FontWeight="SemiBold" FontSize="13"/>
                                                    <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Background="{DynamicResource ControlFillColorTertiaryBrush}">
                                                        <TextBlock x:Name="AuthModeText" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding AuthMode, Converter={StaticResource EnumDescriptionConverter}}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PluginId}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="调用 "/>
                                                        <Run Text="{Binding CallCount}"/>
                                                        <Run Text=" 次"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LastCalledAt, StringFormat='\u6700\u540e: {0:MM-dd HH:mm}'}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="切换授权" Tag="{Binding PluginId}" Click="OnTogglePluginAuthClicked"/>
                                                <Button Content="撤销" Classes="danger" Tag="{Binding PluginId}" Click="OnRevokePluginAuthClicked"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoPluginsText" Text="暂无外部插件调用记录。" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF0020;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="配置管理" Classes="expander-title"/>
                            <TextBlock Text="导入、导出或恢复 AI 配置，导出文件包含 API Key。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE713;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="API 配置" Classes="row-title"/>
                        <TextBlock Text="导出或导入 API 配置。导出文件包含 API Key，请妥善保管。" Classes="row-description"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ImportConfigBtn" Content="导入配置"/>
                        <Button x:Name="ExportConfigBtn" Content="导出配置"/>
                        <Button x:Name="RestoreDefaultsBtn" Content="恢复默认" Classes="danger"/>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF00C5;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="本地数据" Classes="expander-title"/>
                            <TextBlock Text="查看 AI 调用日志，管理本地提示词和离线句子库。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE9D5;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="AI 调用日志" Classes="row-title"/>
                        <TextBlock Text="查看完整提示词、AI 返回内容、本地降级内容及调用错误。" Classes="row-description"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="OpenAiLogsBtn" Content="打开日志文件夹" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="setting-row">
                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                    <TextBlock Text="&#xE8B7;" Classes="row-icon"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="AI 提示词模板" Classes="row-title"/>
                        <TextBlock Text="可自行编辑 Data/ 下的 prompts_*.json 定制 AI 提示词。" Classes="row-description"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="OpenPromptsBtn" Content="打开提示词"/>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Expander>

            <Expander Classes="settings-section" IsExpanded="False">
                <Expander.Header>
                    <Grid Classes="section-header" ColumnDefinitions="32,*" ColumnSpacing="12">
                        <TextBlock Text="&#xF0570;" Classes="expander-icon"/>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="更多选项" Classes="expander-title"/>
                            <TextBlock Text="访问项目主页、查看开源许可、提交反馈、预览提示词与上下文、调整诊断与遥测，或重新运行欢迎向导。" Classes="expander-description"/>
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Classes="section-content" Spacing="6">
                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="打开 GitHub 主页" Classes="row-title"/>
                                <TextBlock Text="查看 AIIsland 源代码、版本记录和项目说明。" Classes="row-description"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="GitHubBtn" Content="打开" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="开源库与许可" Classes="row-title"/>
                                <TextBlock Text="查看使用的开源库、GitHub 地址、版本与许可声明。" Classes="row-description"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="OpenSourceLicensesBtn" Content="查看" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="提交 Bug 或功能建议" Classes="row-title"/>
                                <TextBlock Text="前往 GitHub Issues 反馈问题或提出新的功能建议。" Classes="row-description"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="IssuesBtn" Content="打开" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="重新运行欢迎向导" Classes="row-title"/>
                                <TextBlock Text="再次打开初始配置向导，重新检查和设置主要功能。" Classes="row-description"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="WelcomeWizardButton" Content="运行" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Classes="setting-row">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="提示词与上下文预览" Classes="row-title"/>
                                <TextBlock Text="查看当前 AI 请求实际使用的提示词与上下文数据，用于核对配置和内容。" Classes="row-description"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="TestPromptButton" Content="测试 AI 提示词"/>
                                <Button x:Name="TestContextButton" Content="测试上下文"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander Classes="settings-section" IsExpanded="False">
                        <Expander.Header>
                            <Grid Classes="subsection-header">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="诊断与遥测" Classes="expander-title"/>
                                    <TextBlock Text="匿名上报在线状态、错误与崩溃信息，帮助定位插件问题。" Classes="expander-description"/>
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Classes="subsection-content" Spacing="6">
                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                                    <TextBlock Text="&#xE7B8;" Classes="row-icon"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="匿名遥测" Classes="row-title"/>
                                        <TextBlock Text="上报设备在线心跳、插件错误栈和崩溃现场。关闭后不会建立任何遥测连接。" Classes="row-description"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" x:Name="TelemetryEnabledSwitch" IsChecked="True"/>
                                </Grid>
                            </Border>

                            <Border Classes="setting-row">
                                <Grid ColumnDefinitions="0,*,Auto" ColumnSpacing="14">
                                    <TextBlock Text="&#xE9D5;" Classes="row-icon"/>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="崩溃时附带日志" Classes="row-title"/>
                                        <TextBlock Text="附带 ClassIsland 日志尾部和 Windows 事件日志，定位更快，但日志里可能包含课表名称等本地文本。" Classes="row-description"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" x:Name="TelemetryLogTailSwitch" IsChecked="True"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>

        <!-- 轻提示：浮在内容右下角，不参与布局，几秒后自动消失，点击可立即关闭 -->
        <controls:ToastHostControl x:Name="Toast"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,28,24"/>
    </Grid>
</ci:SettingsPageBase>

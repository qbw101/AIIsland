<Window
    x:Class="ClassIsland.AISmartClass.Views.PromptPreviewWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI 内容预览"
    Width="820" Height="680"
    MinWidth="560" MinHeight="420"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    FontFamily="Microsoft YaHei,Segoe UI,sans-serif">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.description">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
        <StyleInclude Source="avares://ClassIsland.AISmartClass/Styles/StableButtonStyles.axaml"/>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="20" FontWeight="SemiBold"
                   Margin="24,20,24,2"/>
        <TextBlock Grid.Row="1" Classes="description"
                   Text="以下内容来自当前配置和实际 AI 请求链路，不包含 API Key。可选中文本后复制。"
                   TextWrapping="Wrap" Margin="24,0,24,12"/>
        <TextBox x:Name="ContentBox" Grid.Row="2" Margin="24,0,24,16"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True" />
        <Border Grid.Row="3" Padding="20,12"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Content="复制全部" Click="OnCopyClicked"/>
                <Button Content="关闭" Classes="primary" Click="OnCloseClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
